import MakeItLean.Gates

/-!
# Spec review generation (Stage 2)

`#spec_review Pfx "SPEC_REVIEW.md"` writes the side-by-side review: for every declaration under
`Pfx`, in source order, its English doc, its Lean signature and its status. Statuses come from the
elaborated environment (`collectAxioms`), not from parsing source text.
-/

open Lean Elab Command Meta

namespace MakeItLean

/-- Strip surrounding whitespace (`String.trim` is gone in Lean 4.36). -/
def trimS (s : String) : String :=
  String.ofList ((s.toList.dropWhile Char.isWhitespace).reverse.dropWhile Char.isWhitespace).reverse

/-- The review's status line for a declaration. -/
def statusOf (holes : Array Name) (n : Name) (ci : ConstantInfo) : CommandElabM String := do
  if holes.contains n then return "**Implementation hole**: filled by the implementer; nothing else may change"
  match ci with
  | .thmInfo _ =>
    let axs ← liftCoreM (collectAxioms n)
    if axs.contains ``sorryAx then
      return if ci.type.getUsedConstants.any holes.contains
        then "**Obligation**: the implementation must prove this" else "**OPEN (not allowed)**"
    return "Proven"
  | _ => return ""

elab "#spec_review " pfx:ident path:str : command => do
  let env ← getEnv
  let holes ← holeNames pfx.getId
  let mut items : Array (Name × Nat × Name × ConstantInfo) := #[]
  for (n, ci) in constantsUnder env pfx.getId do
    unless isUserFacing env n do continue
    let some r ← findDeclarationRanges? n | continue
    let some m := moduleOf env n | continue
    items := items.push (m, r.range.pos.line, n, ci)
  items := items.qsort fun a b => Name.lt a.1 b.1 || (a.1 == b.1 && a.2.1 < b.2.1)
  let mut out : String := s!"# Spec review: `{pfx.getId}`\n\n> Generated by `mil review` from the elaborated spec. Do not edit.\n"
  let mut nProven : Nat := 0
  let mut nObl : Nat := 0
  let mut curMod := Name.anonymous
  for (m, _, n, ci) in items do
    if m != curMod then out := out ++ s!"\n## `{m}`\n"; curMod := m
    let doc0 : String := trimS ((← findDocString? env n).getD "(no doc)")
    let doc : String := if doc0.startsWith "English:" then trimS (doc0.drop 8).toString else doc0
    let sigF ← liftTermElabM <| PrettyPrinter.ppSignature n
    let sig : String := sigF.fmt.pretty
    let st ← statusOf holes n ci
    if st == "Proven" then nProven := nProven + 1
    if st.startsWith "**Obligation" then nObl := nObl + 1
    out := out ++ s!"\n### `{n}`\n\n{doc}\n\n" ++ (if st.isEmpty then "" else s!"*Status:* {st}\n\n") ++
      s!"```lean\n{sig}\n```\n"
  out := out ++ s!"\n---\nTheorems proven: {nProven}. Obligations for the implementation: {nObl}. Holes: {holes.size}.\n"
  IO.FS.writeFile path.getString out
  logInfo (m!"wrote " ++ path.getString ++ s!": {items.size} declarations, {nProven} proven, {nObl} obligations, {holes.size} holes")

end MakeItLean
